{
  "name": "world",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/world-lib.umd.cjs",
  "module": "dist/world-lib.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/world-lib.js",
      "require": "./dist/world-lib.umd.cjs",
      "types": "./dist/main.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build0": "tsc && vite build",
    "build": "tsc --p ./tsconfig.build.json && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "preview": "vite preview",
    "dev:watch": "tsc-watch --onSuccess \"yarn build\"",
    "test": "vitest --silent=false --reporter=verbose"
  },
  "dependencies": {
    "cloudia-common": "link:../cloudia-common",
    "pug": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/pako": "^2.0.3",
    "@types/pug": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "pako": "^2.1.0",
    "prettier": "^3.1.1",
    "sass": "^1.72.0",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^3.5.3",
    "vite-plugin-lib-inject-css": "^2.0.0",
    "vitest": "^1.1.0"
  }
}
