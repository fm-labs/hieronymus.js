{
  "name": "@fmlabs/hieronymus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/hieronymus-lib.umd.cjs",
  "module": "dist/hieronymus-lib.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hieronymus-lib.js",
      "require": "./dist/hieronymus-lib.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --p ./tsconfig.build.json && vite build",
    "build:watch": "vite build --watch",
    "examples": "pnpm --filter @fmlabs/hieronymus-examples dev",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "preview": "vite preview",
    "test": "vitest --silent=false --reporter=verbose"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pako": "^2.0.4",
    "@types/pug": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "pako": "^2.2.0",
    "prettier": "^3.10.1",
    "pug": "^3.0.4",
    "sass": "^1.108.2",
    "tsc-watch": "^6.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^1.6.1"
  }
}
